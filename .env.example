# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this to backend/.env for local development.

# Database connection string.
# SQLite (default for local dev): sqlite:///./birthday_app.db
# PostgreSQL (production):        postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./birthday_app.db

# Server bind settings (used by uvicorn when running directly)
PORT=8000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins.
# IMPORTANT: In production, set this to your exact frontend URL(s).
# Using "*" is a security risk — never use it in production.
# Example: https://techstack-psi.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application secret key — used for any hashing or session signing.
# Generate a strong random key for production:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key


# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy these to frontend/.env.local for local development.

# Backend API base URL.
# Leave empty for local dev (Vite proxy handles /api → http://127.0.0.1:8000).
# For production pointing to a separate backend, set the full URL:
# e.g. https://my-birthday-backend.onrender.com/api
VITE_API_BASE_URL=

# Production site absolute URL — required for og:image social preview links.
# Set to your Vercel deployment URL. Do NOT include a trailing slash.
VITE_SITE_URL=https://dhanyaacharya.vercel.app
