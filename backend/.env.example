# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to backend/.env for local development.
# For production (Vercel / Render / Railway / Fly.io), set these as
# Environment Variables in your hosting provider's dashboard.

# Database connection string.
# SQLite (default for local dev — no setup required):
DATABASE_URL=sqlite:///./birthday_app.db
# PostgreSQL (recommended for production — persistent across serverless cold starts):
# DATABASE_URL=postgresql://user:password@host:5432/birthday_db

# Server bind settings (used when running: python -m uvicorn app.main:app)
PORT=8000
HOST=0.0.0.0

# Comma-separated CORS allowed origins.
# SECURITY: In production, replace * with your actual frontend URL(s).
# Example: https://dhanyaacharya.vercel.app
# Never use * in production with allow_credentials=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application secret key.
# Generate a secure random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key
