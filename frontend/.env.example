# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local for local development, or set these as
# Environment Variables in your Vercel project settings.

# Backend API base URL.
# • Local development (default): leave empty — Vite proxy handles /api → http://127.0.0.1:8000
# • Production on Vercel: if frontend & backend are on the same domain (proxied via vercel.json),
#   leave empty so /api works as a relative path.
# • If backend is on a separate service (Render, Railway, etc.):
#   set this to your backend root URL, e.g. https://my-backend.onrender.com/api
VITE_API_BASE_URL=

# Production site URL — used to generate absolute Open Graph / Twitter preview image URLs.
# REQUIRED for social-link previews (WhatsApp, Facebook, Telegram, Twitter/X) to show the image.
# Set to your exact Vercel deployment URL, e.g. https://techstack-psi.vercel.app
# Do NOT include a trailing slash.
VITE_SITE_URL=https://your-vercel-domain.vercel.app
